# ===== マイルストーン（Timeline） =====
# マイルストーン一覧の自動再取得間隔（ms）。既定 3600000（60 分）。
# バックエンドの猶予チェック間隔 MILESTONE_CLOSE_INTERVAL_MINUTES(既定 60 分)に揃える。
VITE_MILESTONE_REFRESH_INTERVAL_MS=3600000

# マイルストーン自動 close の猶予日数（accomplished_date から何日後に closed 化するか）。既定 5。
# バックエンドの MILESTONE_CLOSE_GRACE_DAYS と同一の値を設定すること。
VITE_MILESTONE_CLOSE_GRACE_DAYS=5
